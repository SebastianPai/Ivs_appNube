# .env de PRODUCCIÓN para cPanel. Copiar a ~/ivs_administracion/.env y completar lo marcado con <...>.
# Reemplaza <usuario_cpanel> por tu usuario de cPanel (aparece en la ruta /home/<usuario_cpanel>).

APP_NAME="Nube de IVS Certificaciones"
APP_ENV=production
APP_KEY=<se copia del .env local: la misma clave mantiene válidas las sesiones y datos cifrados>
APP_DEBUG=false
APP_TIMEZONE=America/Bogota
APP_URL=https://ivscertificaciones.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=warning

# cPanel → "Bases de datos MySQL": el nombre y el usuario llevan el prefijo del usuario de cPanel
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<usuario_cpanel>_ivs
DB_USERNAME=<usuario_cpanel>_ivs
DB_PASSWORD=<contraseña de la base de datos>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Sin procesos permanentes en cPanel: el cron de schedule:run procesa la cola cada minuto
DOCUMENTOS_COLA_POR_CRON=true

# Límite por archivo (KB). Debe ser menor que upload_max_filesize de public_html/.user.ini (100M)
DOCUMENTOS_MAX_KB=98304

# En hosting compartido normalmente no hay qpdf ni Ghostscript: las herramientas PDF se desactivan solas.
# Si el hosting los tiene, indica la ruta (pregúntale a soporte): QPDF_PATH=/usr/bin/qpdf
# QPDF_PATH=

MAIL_MAILER=smtp
MAIL_HOST=mail.ivscertificaciones.com
MAIL_PORT=465
MAIL_USERNAME=<correo@ivscertificaciones.com>
MAIL_PASSWORD=<contraseña del correo>
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="<correo@ivscertificaciones.com>"
MAIL_FROM_NAME="${APP_NAME}"

# Firebase Storage. El .json va en ~/ivs_administracion/storage/credenciales/ (FUERA de public_html)
FIREBASE_CREDENTIALS=/home/<usuario_cpanel>/ivs_administracion/storage/credenciales/firebase-cuenta-servicio.json
FIREBASE_PROJECT_ID=ivscertificaciones-c208f
FIREBASE_STORAGE_BUCKET=ivscertificaciones-c208f.appspot.com
FIREBASE_STORAGE_PREFIX=

# Los archivos recuperados ya viven en el bucket. Las subidas nuevas también van al bucket:
# el disco del hosting es limitado y así hay una sola fuente de verdad.
DOCUMENTOS_DISCO_RECUPERACION=firebase
DOCUMENTOS_DISK=firebase
